# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...

# Канал: @username публичного канала или числовой id (-100...) приватного
TELEGRAM_CHANNEL_ID=@my_nba_news

# Язык перевода заголовков (ru). Оставьте пустым, чтобы публиковать на английском
TRANSLATE_TO=ru

# 1 = под русским заголовком показывать оригинальный заголовок курсивом
SHOW_ORIGINAL=0

# 0 = при первом запуске НЕ публиковать уже существующие новости (рекомендуется)
POST_ON_FIRST_RUN=0

DB_PATH=data/seen.db
LOG_LEVEL=INFO
